  - evidenceID: Notebook
    discoveredPicture: {fileID: 21300000, guid: 3bbb4036bf2df437f9cffacaa464efb2, type: 3}
    discoveredName: Notebook
    detailedInformation: "The notebook contains Victor\u2019s true feelings toward
